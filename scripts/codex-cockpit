#!/bin/zsh
set -euo pipefail

# Start Codex through Cockpit Tools' local, authenticated API service while
# retaining the verified CLIProxyAPI profile as the base configuration.  The
# endpoint and auth command are supplied at launch time, so Cockpit port/key
# changes do not require a checked-in or hand-edited Codex profile.
SCRIPT_DIR="${0:A:h}"
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
COCKPIT_CODEX_PROFILE="${COCKPIT_CODEX_PROFILE:-cliproxy}"
export CODEX_HOME

# Keep one user-facing command. Plain interactive launches get tmux and exact
# thread recovery from codex-default-longrun; native subcommands and advanced
# flags continue straight to Codex. The supervisor sets CODEX_COCKPIT_DIRECT
# when it calls this launcher, preventing a recursive tmux wrapper.
typeset -a CODEX_ARGS
typeset launcher_arg
cockpit_direct="${CODEX_COCKPIT_DIRECT:-0}"
for launcher_arg in "$@"; do
  if [[ "$launcher_arg" == "--direct" ]]; then
    cockpit_direct=1
  else
    CODEX_ARGS+=("$launcher_arg")
  fi
done
set -- "${CODEX_ARGS[@]}"

if [[ "$cockpit_direct" != "1" ]]; then
  typeset -a inspect_args
  inspect_args=("$@")
  integer inspect_index=1
  integer prompt_set=0
  integer longrun_compatible=1
  integer longrun_option_seen=0
  longrun_project="$PWD"
  longrun_prompt=""
  longrun_session=""

  for launcher_arg in "${inspect_args[@]}"; do
    if [[ "$launcher_arg" == "--longrun-session" || "$launcher_arg" == --longrun-session=* ]]; then
      longrun_option_seen=1
      break
    fi
  done

  while ((inspect_index <= ${#inspect_args})); do
    launcher_arg="${inspect_args[$inspect_index]}"
    case "$launcher_arg" in
      -C|--cd)
        if ((inspect_index + 1 > ${#inspect_args})); then
          print -u2 "codex-cockpit: $launcher_arg requires a directory"
          exit 64
        fi
        longrun_project="${inspect_args[$((inspect_index + 1))]}"
        inspect_index=$((inspect_index + 2))
        ;;
      --cd=*)
        longrun_project="${launcher_arg#--cd=}"
        inspect_index=$((inspect_index + 1))
        ;;
      --longrun-session)
        if ((inspect_index + 1 > ${#inspect_args})); then
          print -u2 "codex-cockpit: --longrun-session requires a name"
          exit 64
        fi
        longrun_session="${inspect_args[$((inspect_index + 1))]}"
        inspect_index=$((inspect_index + 2))
        ;;
      --longrun-session=*)
        longrun_session="${launcher_arg#--longrun-session=}"
        inspect_index=$((inspect_index + 1))
        ;;
      exec|review|login|logout|mcp|plugin|mcp-server|app-server|remote-control|app|completion|update|doctor|sandbox|debug|apply|resume|archive|delete|unarchive|fork|cloud|exec-server|features|help)
        longrun_compatible=0
        break
        ;;
      -*)
        longrun_compatible=0
        break
        ;;
      *)
        if ((prompt_set)); then
          longrun_compatible=0
          break
        fi
        longrun_prompt="$launcher_arg"
        prompt_set=1
        inspect_index=$((inspect_index + 1))
        ;;
    esac
  done

  if ((!longrun_compatible && longrun_option_seen)); then
    print -u2 "codex-cockpit: --longrun-session can only be used with -C/--cd and one optional prompt"
    print -u2 "Use codex-cockpit --direct for native Codex flags and subcommands."
    exit 64
  fi

  if ((longrun_compatible)); then
    if ! longrun_project="$(cd -- "$longrun_project" 2>/dev/null && pwd -P)"; then
      print -u2 "codex-cockpit: project directory does not exist"
      exit 64
    fi

    if ((longrun_option_seen)) && [[ -z "$longrun_session" ]]; then
      print -u2 "codex-cockpit: --longrun-session requires a non-empty name"
      exit 64
    fi
    if [[ -n "$longrun_session" && ! "$longrun_session" =~ '^[A-Za-z0-9_.-]+$' ]]; then
      print -u2 "codex-cockpit: long-run session may contain only letters, digits, dot, underscore, and dash"
      exit 64
    fi

    if [[ -n "${CODEX_COCKPIT_LONGRUN_BIN:-}" ]]; then
      longrun_bin="$CODEX_COCKPIT_LONGRUN_BIN"
    elif [[ -x "$SCRIPT_DIR/codex-default-longrun" ]]; then
      longrun_bin="$SCRIPT_DIR/codex-default-longrun"
    elif (( $+commands[codex-default-longrun] )); then
      longrun_bin="$commands[codex-default-longrun]"
    else
      print -u2 "codex-cockpit: cannot find codex-default-longrun in PATH"
      print -u2 "Install the long-run supervisor beside codex-cockpit or set CODEX_COCKPIT_LONGRUN_BIN."
      exit 78
    fi
    if [[ ! -x "$longrun_bin" ]]; then
      print -u2 "codex-cockpit: long-run supervisor is not executable: $longrun_bin"
      exit 78
    fi

    inside_tmux=0
    if [[ -n "${TMUX:-}" ]] && (( $+commands[tmux] )); then
      if current_tmux_session="$(tmux display-message -p '#S' 2>/dev/null)" && [[ -n "$current_tmux_session" ]]; then
        inside_tmux=1
        if [[ -n "$longrun_session" && "$longrun_session" != "$current_tmux_session" ]]; then
          print -u2 "codex-cockpit: already inside tmux; using current session '$current_tmux_session'"
        fi
        longrun_session="$current_tmux_session"
      fi
    fi

    if [[ -z "$longrun_session" ]]; then
      project_slug="${longrun_project:t}"
      project_slug="${project_slug//[^A-Za-z0-9_.-]/_}"
      [[ -n "$project_slug" ]] || project_slug="project"
      longrun_session="codex_${project_slug}_$(date '+%Y%m%d_%H%M%S')_$$"
    fi
    if [[ ! "$longrun_session" =~ '^[A-Za-z0-9_.-]+$' ]]; then
      print -u2 "codex-cockpit: current tmux session name is not safe for the long-run state path"
      exit 64
    fi

    cockpit_launcher="${0:A}"
    runtime_dir="$CODEX_HOME/default-longrun/$longrun_session"
    typeset -a supervisor_args
    supervisor_args=(
      --session "$longrun_session"
      --project "$longrun_project"
      --launcher "$cockpit_launcher"
      --codex-home "$CODEX_HOME"
      --runtime-dir "$runtime_dir"
    )
    if ((prompt_set)); then
      supervisor_args+=(--prompt "$longrun_prompt")
    fi
    if ((inside_tmux)); then
      supervisor_args=(--supervise "${supervisor_args[@]}")
    else
      supervisor_args+=(--attach)
    fi

    export CODEX_COCKPIT_DIRECT=1
    exec "$longrun_bin" "${supervisor_args[@]}"
  fi
fi

if [[ -n "${CODEX_BIN:-}" && -x "$CODEX_BIN" ]]; then
  :
elif (( $+commands[codex] )); then
  CODEX_BIN="$commands[codex]"
else
  print -u2 "codex-cockpit: cannot find the codex executable in PATH"
  exit 127
fi

PROFILE_FILE="$CODEX_HOME/${COCKPIT_CODEX_PROFILE}.config.toml"
if [[ ! -f "$PROFILE_FILE" ]]; then
  print -u2 "codex-cockpit: missing $PROFILE_FILE"
  print -u2 "Set COCKPIT_CODEX_PROFILE to a Codex profile based on codex-cliproxyapi."
  exit 78
fi

API_HELPER="$SCRIPT_DIR/cockpit-tools-api"
if [[ ! -x "$API_HELPER" ]]; then
  print -u2 "codex-cockpit: missing executable $API_HELPER"
  print -u2 "Install codex-cockpit together with cockpit-tools-api."
  exit 78
fi

# Codex executes provider auth commands through the inherited PATH.  Keeping
# the helper beside this launcher also makes a copied /opt/homebrew/bin pair
# self-contained, without embedding a user-specific absolute path in config.
export PATH="$SCRIPT_DIR:$PATH"

if [[ "${COCKPIT_CODEX_SKIP_HEALTHCHECK:-0}" != "1" ]]; then
  "$API_HELPER" --check
fi

# The verified base profile uses the cliproxyapi provider.  These overrides
# leave its model/sandbox/retry settings intact while replacing only the
# endpoint and runtime auth command.  The API helper reads Cockpit's current
# key on every Codex auth refresh, including after key rotation.  The base
# profile may intentionally use refresh_interval_ms=0 for a different proxy;
# that setting makes Codex wait for an authentication failure before fetching
# a token, which produces a needless 401 before every Cockpit request. Keep
# the documented proactive refresh cadence for this dynamic local key.
COCKPIT_BASE_URL="$($API_HELPER --endpoint)"
COCKPIT_PROVIDER="${COCKPIT_CODEX_PROVIDER:-cliproxyapi}"
if [[ ! "$COCKPIT_PROVIDER" =~ '^[A-Za-z0-9_-]+$' ]]; then
  print -u2 "codex-cockpit: invalid provider name"
  exit 78
fi

exec "$CODEX_BIN" \
  --profile "$COCKPIT_CODEX_PROFILE" \
  --strict-config \
  --no-alt-screen \
  -c "model_provider=\"$COCKPIT_PROVIDER\"" \
  -c "model_providers.$COCKPIT_PROVIDER.base_url=\"$COCKPIT_BASE_URL\"" \
  -c "model_providers.$COCKPIT_PROVIDER.auth.command=\"cockpit-tools-api\"" \
  -c "model_providers.$COCKPIT_PROVIDER.auth.args=[\"--token\"]" \
  -c "model_providers.$COCKPIT_PROVIDER.auth.refresh_interval_ms=300000" \
  "$@"
